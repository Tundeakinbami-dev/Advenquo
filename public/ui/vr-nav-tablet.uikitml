<!--
  Advenquo: Builder Tablet HUD — In-VR Spatial Construction Control Panel.
  Attached to the builder's workstation in front of the construction pad.
-->
<style>
  .root {
    flex-direction: column;
    width: 44;
    background-color: rgba(15, 23, 42, 0.95);
    border-radius: 1.2;
    border-width: 0.15;
    border-color: #0284c7;
  }

  .nav-header {
    background-color: #0369a1;
    padding-top: 1.2;
    padding-bottom: 1.2;
    padding-left: 1.5;
    padding-right: 1.5;
    border-radius: 1.2;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title-brand {
    font-size: 2.0;
    font-weight: 700;
    color: #f8fafc;
  }

  .project-badge {
    font-size: 1.2;
    font-weight: 600;
    color: #bae6fd;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 0.5;
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 0.8;
    padding-right: 0.8;
  }

  .content-body {
    padding-top: 1.4;
    padding-bottom: 1.4;
    padding-left: 1.8;
    padding-right: 1.8;
    flex-direction: column;
    gap: 1.0;
  }

  .section-title {
    font-size: 1.3;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.05;
  }

  .stage-box {
    background-color: rgba(30, 41, 59, 0.85);
    border-radius: 0.8;
    border-width: 0.08;
    border-color: rgba(255, 255, 255, 0.12);
    padding: 1.2;
    flex-direction: column;
    gap: 0.6;
  }

  .stage-title {
    font-size: 1.5;
    font-weight: 700;
    color: #f1f5f9;
  }

  .stage-instruction {
    font-size: 1.25;
    color: #cbd5e1;
    line-height: 1.35;
  }

  .critical-box {
    background-color: rgba(14, 116, 144, 0.2);
    border-radius: 0.6;
    border-width: 0.08;
    border-color: #06b6d4;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.0;
    padding-right: 1.0;
    flex-direction: row;
    align-items: center;
  }

  .critical-text {
    font-size: 1.15;
    color: #67e8f9;
  }

  .action-bar {
    flex-direction: row;
    gap: 1.0;
    margin-top: 0.5;
  }

  .action-btn {
    background-color: #0284c7;
    border-radius: 0.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.4;
    padding-right: 1.4;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .action-btn-text {
    font-size: 1.3;
    font-weight: 700;
    color: #ffffff;
  }

  .secondary-btn {
    background-color: rgba(51, 65, 85, 0.8);
    border-radius: 0.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.2;
    padding-right: 1.2;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .secondary-btn-text {
    font-size: 1.2;
    font-weight: 600;
    color: #94a3b8;
  }

  .status-footer {
    font-size: 1.1;
    color: #64748b;
    text-align: center;
    margin-top: 0.4;
  }
</style>

<div class="root" id="builder-tablet-root">
  <div class="nav-header">
    <div class="title-brand">ADVENQUO BUILDER</div>
    <div class="project-badge" id="tablet-project-title">Eco-Pavilion Small House</div>
  </div>

  <div class="content-body">
    <div class="section-title">ACTIVE CONSTRUCTION STAGE</div>
    <div class="stage-box">
      <div class="stage-title" id="tablet-stage-counter">Stage 1 / 6: Foundation Inspection</div>
      <div class="stage-instruction" id="tablet-instruction-text">
        Inspect the reinforced concrete foundation slab footing at the center of the workshop.
      </div>
      <div class="critical-box">
        <div class="critical-text" id="tablet-critical-check">
          Critical: Foundation footing must be level and free of structural cracks.
        </div>
      </div>
    </div>

    <div class="action-bar" style="margin-bottom: 0.6;">
      <div class="action-btn" id="btn-tablet-blueprint">
        <div class="action-btn-text">Blueprint Mode</div>
      </div>
      <div class="secondary-btn" id="btn-tablet-pin">
        <div class="secondary-btn-text">Pin Beside Pad</div>
      </div>
      <div class="secondary-btn" id="btn-tablet-hint">
        <div class="secondary-btn-text">Guide Hint</div>
      </div>
    </div>

    <div class="action-bar">
      <div class="action-btn" id="btn-tablet-validate">
        <div class="action-btn-text">Validate Structure</div>
      </div>
      <div class="secondary-btn" id="btn-tablet-undo">
        <div class="secondary-btn-text">Undo Placement</div>
      </div>
      <div class="secondary-btn" id="btn-tablet-reset">
        <div class="secondary-btn-text">Reset Project</div>
      </div>
    </div>

    <div class="status-footer" id="tablet-status-text">
      Meta Quest 3 Seated 2-Handed VR Mode Active
    </div>
  </div>
</div>
