<!--
  Advenquo — Fact panel: Adire Cloth.
  Appears above the Adire cloth object when the player discovers it.
  Auto-hides after 8 seconds (managed by SceneUISystem).
  Width 32 cm, positioned above the cloth in the scene.
-->
<style>
  .root {
    flex-direction: column;
    width: 32;
    background-color: rgba(26, 35, 126, 0.95);
    border-radius: 1;
    border-width: 0.15;
    border-color: #f5d370;
  }

  .badge {
    background-color: #f5d370;
    border-radius: 0.8;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.5;
    padding-right: 1.5;
    align-self: flex-start;
    margin-top: 1.5;
    margin-left: 1.5;
  }

  .badge-text {
    font-size: 1.1;
    font-weight: 700;
    color: #1a237e;
    text-align: center;
  }

  .title {
    font-size: 2;
    font-weight: 700;
    color: #f5d370;
    margin-top: 0.8;
    margin-left: 1.5;
    margin-right: 1.5;
  }

  .divider {
    height: 0.1;
    background-color: rgba(245, 211, 112, 0.4);
    margin-top: 0.8;
    margin-left: 1.5;
    margin-right: 1.5;
  }

  .fact {
    font-size: 1.55;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1;
    margin-left: 1.5;
    margin-right: 1.5;
    margin-bottom: 0.5;
    line-height: 1.45;
  }

  .word {
    font-size: 1.3;
    color: #90caf9;
    margin-top: 0.5;
    margin-left: 1.5;
    margin-bottom: 1.5;
  }
</style>

<Panel class="root">
  <div class="badge">
    <div class="badge-text">DISCOVERY</div>
  </div>
  <div class="title">Adire Cloth</div>
  <div class="divider"></div>
  <div class="fact">
    Adire is a Yoruba tradition of resist-dyeing cloth in deep indigo blue.
    Geometric patterns are drawn in cassava paste, then the cloth is submerged
    in pots of indigo dye. Each pattern carries meaning: family, status,
    or a prayer.
  </div>
  <div class="word">Yoruba word: Adire (ah-dee-reh) - to tie and dye</div>
</Panel>
