<!--
  Advenquo — VR Construction Intro & Control Panel.
  Shown in the spatial construction workshop.
  In XR, the Enter/Exit buttons swap based on immersive state.
  The build progress text is updated by ConstructionInteractionSystem.

  UIKit units are centimetres. This panel is 32 cm wide × 38 cm tall.
-->
<style>
  .root {
    flex-direction: column;
    width: 32;
    background-color: rgba(11, 19, 41, 0.94);
    border-radius: 1.2;
    border-width: 0.15;
    border-color: #0284c7;
  }

  .header {
    background-color: #0369a1;
    padding-top: 2;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    border-radius: 1.2;
    align-items: center;
  }

  .title {
    font-size: 2.2;
    font-weight: 700;
    color: #f8fafc;
    text-align: center;
    letter-spacing: -0.05;
  }

  .subtitle {
    font-size: 1.3;
    color: #bae6fd;
    text-align: center;
    margin-top: 0.4;
  }

  .body {
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    flex-direction: column;
    gap: 1;
  }

  .instruction {
    font-size: 1.4;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }

  .counter {
    font-size: 1.5;
    font-weight: 600;
    color: #38bdf8;
    margin-top: 0.5;
  }

  .btn-row {
    padding-left: 2;
    padding-right: 2;
    padding-bottom: 2;
    flex-direction: column;
    gap: 0.8;
  }

  .xr-btn {
    background-color: #0284c7;
    border-radius: 0.8;
    padding-top: 1.2;
    padding-bottom: 1.2;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .xr-btn-label {
    font-size: 1.5;
    font-weight: 700;
    color: #ffffff;
  }

  .exit-btn {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 0.8;
    border-width: 0.1;
    border-color: rgba(255, 255, 255, 0.3);
    padding-top: 1;
    padding-bottom: 1;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .exit-btn-label {
    font-size: 1.3;
    color: rgba(255, 255, 255, 0.7);
  }
</style>

<Panel class="root">
  <div class="header">
    <div class="title">ADVENQUO</div>
    <div class="subtitle">VR Construction World</div>
  </div>

  <div class="body">
    <div class="instruction">
      Sit comfortably and use both hands to grab blocks, rotate with your wrists, and snap modular materials onto the foundation.
    </div>
    <div id="discovery-count" class="counter">Project: Eco-Pavilion House</div>
  </div>

  <div class="btn-row">
    <div id="xr-enter-btn" class="xr-btn">
      <div class="xr-btn-label">Enter VR Workshop</div>
    </div>
    <div id="xr-exit-btn" class="exit-btn" style="display: none">
      <div class="exit-btn-label">Exit to Browser</div>
    </div>
  </div>
</Panel>
