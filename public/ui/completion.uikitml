<!--
  Advenquo — Structural Engineering Validation Celebration Panel.
  Shown when the assembled structure passes blueprint & stability assessment.
-->
<style>
  .root {
    flex-direction: column;
    width: 32;
    background-color: rgba(11, 19, 41, 0.94);
    border-radius: 1.2;
    border-width: 0.15;
    border-color: #059669;
  }

  .header {
    background-color: #047857;
    padding-top: 2;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    border-radius: 1.2;
    align-items: center;
  }

  .title {
    font-size: 2.2;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    letter-spacing: -0.05;
  }

  .subtitle {
    font-size: 1.3;
    color: #a7f3d0;
    text-align: center;
    margin-top: 0.4;
  }

  .body {
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    flex-direction: column;
    gap: 1;
  }

  .message {
    font-size: 1.4;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }

  .unlocked {
    font-size: 1.5;
    font-weight: 600;
    color: #34d399;
    margin-top: 0.5;
  }
</style>

<Panel class="root">
  <div class="header">
    <div class="title">STRUCTURE CERTIFIED!</div>
    <div class="subtitle">Validation Passed</div>
  </div>

  <div class="body">
    <div class="message">
      All blueprint connections verified with continuous load-path continuity to the foundation pad.
    </div>
    <div class="unlocked">
      +250 XP Awarded | Next Challenge Unlocked
    </div>
  </div>
</Panel>
